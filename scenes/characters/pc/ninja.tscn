[sub_resource type="GDScript" id="GDScript_mmjo4"]
script/source = "extends Player

@export var Primary_Move_Buffer : Buffer

func _process(_delta: float) -> void:
	ANM_Animation_Tree.set(\"parameters/conditions/attack\", Primary_Move_Buffer.buffer)

func primary():
	Primary_Move_Buffer.start()
	quick_pause()

func secondary():
	quick_pause()
	ANM_Animation_Tree.get(\"parameters/playback\").travel(\"shoot\")

func SP_Handler(delta):
	if SP > 0:
		SP -= delta
		SP_Effect(1.2, 1.2)
	else:
		SP = 0
		SP_Effect()
"

