[sub_resource type="GDScript" id="GDScript_83h6q"]
script/source = "extends Boss

@export var attack_buffer : Buffer

@export_group(\"Flames\", \"FL\")
@export var FL_area : Area2D
@export var FL_sprite : AnimatedSprite2D
@export var FL_anim_tree : AnimationTree

var flying : bool = false
var fly_at_hp : Array[int] = [450, 350, 250, 150, 50]
var flight_count : int = 0
var bite_count: int = 0

func _physics_process(delta: float) -> void:
	super._physics_process(delta)
	await try_flight()

#region Charge
func charge(target : Entity):
	var to_target := target.global_position - global_position
	if to_target.length() > Attack_Range: move(to_target.normalized().x)
	if bite_count < 3 and to_target.length() > 200: move(to_target.normalized().x)
	else:
		if to_target.x * facing < 0: flip()
		move(0)
		if bite_count < 3 and attack_buffer.timer <= 0:
			attack_buffer.start()
			primary()
			bite_count += 1
		elif attack_buffer.timer <= 0:
			attack_buffer.start()
			secondary()
			bite_count = 0

func primary(): await force_anim(\"attack_1\")
func secondary(): await force_anim(\"attack_2\")
#endregion

#region Ground Blaze
func try_flight():
	for i in range(fly_at_hp.size()):
		var this_hp = fly_at_hp[i]
		if hp <= this_hp and flight_count <= i: await ground_blaze(i)

func ground_blaze(count : int):
	flying = true
	puppet = true
	flight_count = count + 1
	set_collision_layer_value(4, false)
	set_collision_layer_value(7, true)
	var side = -1 if randf() < 0.5 else 1
	if side*facing < 0:
		flip()
		await get_tree().physics_frame
	var wait_timer = get_tree().create_timer(5)
	while not block_check_ray.is_colliding():
		move(side, true)
		await get_tree().physics_frame
	flip()
	await wait_timer.timeout
	FL_anim_tree.get(\"parameters/playback\").travel(\"blaze\")
	FL_sprite.show()
	while not block_check_ray.is_colliding():
		move(-side, true)
		for body in FL_area.get_overlapping_bodies():
			if body is Entity: body.hurt(get_physics_process_delta_time()*220)
		await get_tree().physics_frame
	FL_anim_tree.get(\"parameters/playback\").travel(\"end\")
	while not FL_sprite.animation == \"end\" and FL_sprite.frame == 3: await get_tree().process_frame
	FL_sprite.hide()
	puppet = false
	set_collision_layer_value(7, false)
	set_collision_layer_value(4, true)
	flying = false
#endregion

#region othere overwrites
func move(x_dir : float, run : bool = false):
	if x_dir * facing < 0 : flip()
	if pause_movement():
		velocity.x = 0
		return
	var delta = get_physics_process_delta_time()
	if x_dir != 0:
		if run: velocity.x = x_dir * Run_Speed * delta * 60
		else: velocity.x = x_dir * Walk_Speed * delta * 50
	else: velocity.x = 0

func hurt(amount: float) -> void:
	if hp <= 0: return
	hp -= amount
	move(0)
	if hp <= 0: die()
#endregion
"

