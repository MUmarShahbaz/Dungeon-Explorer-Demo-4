[sub_resource type="GDScript" id="GDScript_83h6q"]
script/source = "extends Boss

var flying : bool = false
var flight_count : int = 0
var fly_at_hp : Array = [250, 150, 50]

func primary(): start_anim(\"attack_1\", true)

func secondary(): start_anim(\"attack_2\", true)

func _physics_process(delta: float) -> void:
	try_flight()
	if flying:
		fly()
		return
	super._physics_process(delta)
	patrol()

func try_flight():
	if not flying:
		for i in range(fly_at_hp.size()):
			var hp_mark = fly_at_hp[i]
			if hp < hp_mark and flight_count <= i:
				flight_count = i + 1
				flying = true

func fly():
	pass
"

