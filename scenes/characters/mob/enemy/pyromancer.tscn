[sub_resource type="GDScript" id="GDScript_ludyu"]
script/source = "extends Enemy

@export var attack_buffer : Buffer
@export var melee_controller : MeleeController
@export var atk3_dps : float
@export var atk3_damage_zone : DamageZone

var attack_3_reported : bool = false

func _process(_delta: float) -> void:
	ANM_Animation_Tree.set(\"parameters/conditions/attack\", attack_buffer.buffer and not melee_controller.is_cooldown)
	if check_anim(\"attack_3\") and not attack_3_reported:
		attack_3_reported = true
		attack_3()

func primary():
	attack_buffer.start()

func attack_3():
	while check_anim(\"attack_3\"):
		if ANM_Animated_Sprite.frame > 5 and ANM_Animated_Sprite.frame < 12:
			atk3_damage_zone.damage_all(atk3_dps*get_physics_process_delta_time())
		if not get_tree(): continue
		await get_tree().physics_frame
	melee_controller.try_cooldown()
	attack_3_reported = false
"

