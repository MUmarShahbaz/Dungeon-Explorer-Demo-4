[sub_resource type="GDScript" id="GDScript_mjynd"]
script/source = "extends Projectile

func _physics_process(_delta: float) -> void:
	var bodies = get_colliding_bodies()
	if bodies.size() > 0:
		hide()
		set_physics_process(false)
		$arrow_hit.play()
		if bodies[0] is Entity:
			(bodies[0] as Entity).hurt(damage)
			(bodies[0] as Entity).velocity.x += 10*direction
		await get_tree().create_timer($arrow_hit.stream.get_length() + 0.1).timeout
		queue_free()
"

