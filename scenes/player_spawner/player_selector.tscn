[sub_resource type="GDScript" id="GDScript_6fp4g"]
script/source = "extends CanvasLayer
class_name PlayerSelector

@export var grid : GridContainer
@export var label : Label
@export var continue_btn : Button

var selected : Dictionary

func  _ready() -> void:
	grid.columns = ceil(sqrt(QuickScripts.playable.size()))
	for this_character in QuickScripts.playable:
		add_button(this_character, load(QuickScripts.all_characters[this_character][&\"image\"]))
	continue_btn.grab_focus()

func add_button(my_name: StringName, image : Texture2D):
	var my_button : TextureButton = TextureButton.new()
	my_button.name = my_name
	my_button.stretch_mode = TextureButton.StretchMode.STRETCH_KEEP_ASPECT_COVERED
	my_button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	my_button.size_flags_vertical = Control.SIZE_EXPAND_FILL
	my_button.texture_normal = AtlasTexture.new()
	my_button.texture_normal.atlas = image
	my_button.focus_entered.connect(func ():
		(my_button.texture_normal as AtlasTexture).region.position = Vector2(16, 8)
		(my_button.texture_normal as AtlasTexture).region.size = Vector2(32, 32)
		)
	my_button.focus_exited.connect(func ():
		(my_button.texture_normal as AtlasTexture).region.position = Vector2(0, 0)
		(my_button.texture_normal as AtlasTexture).region.size = Vector2(0, 0)
		)
	my_button.pressed.connect(func ():
		label.text = my_name
		selected = QuickScripts.all_characters[my_name]
	)
	grid.add_child.call_deferred(my_button)
"

