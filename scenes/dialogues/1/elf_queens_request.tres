[sub_resource type="Resource" id="Resource_n17dh"]
script = ExtResource("1_iaqwv")
Text = "Brave Knight!!"
Sprite = ExtResource("2_k6dw8")
Right_Side = true
metadata/_custom_type_script = "uid://86nuwqny3eip"

[sub_resource type="Resource" id="Resource_124ty"]
script = ExtResource("1_iaqwv")
Text = "The crown seeks your aid!!"
Sprite = ExtResource("3_5220t")
Right_Side = true
metadata/_custom_type_script = "uid://86nuwqny3eip"

[sub_resource type="Resource" id="Resource_4ruvg"]
script = ExtResource("1_iaqwv")
Text = "Regretably, the King has fallen extremely ill.
The Royal Physician claims only a miracle can save him."
Sprite = ExtResource("4_xe3bs")
Right_Side = true
metadata/_custom_type_script = "uid://86nuwqny3eip"

[sub_resource type="Resource" id="Resource_k6dw8"]
script = ExtResource("1_iaqwv")
Text = "That is where you come in."
Sprite = ExtResource("5_124ty")
Right_Side = true
metadata/_custom_type_script = "uid://86nuwqny3eip"

[sub_resource type="Resource" id="Resource_h3tuu"]
script = ExtResource("1_iaqwv")
Text = "Go to the depths of the dungeon
and find the dark lady."
Sprite = ExtResource("6_4ruvg")
Right_Side = true
metadata/_custom_type_script = "uid://86nuwqny3eip"

[sub_resource type="Resource" id="Resource_e32di"]
script = ExtResource("1_iaqwv")
Text = "Tell her that I sent you and
inform her of the king's health"
Sprite = ExtResource("6_4ruvg")
Right_Side = true
metadata/_custom_type_script = "uid://86nuwqny3eip"

[sub_resource type="Resource" id="Resource_ds3jl"]
script = ExtResource("1_iaqwv")
Text = "Bring her healing potion to me
and I shall heal our king!"
Sprite = ExtResource("4_xe3bs")
Right_Side = true
metadata/_custom_type_script = "uid://86nuwqny3eip"

[sub_resource type="Resource" id="Resource_jbb2u"]
script = ExtResource("1_iaqwv")
Text = "Now away!!
Time is short!!"
Sprite = ExtResource("6_4ruvg")
Right_Side = true
metadata/_custom_type_script = "uid://86nuwqny3eip"

[sub_resource type="Resource" id="Resource_qy380"]
script = ExtResource("1_iaqwv")
Text = "Right away your highness!!"
Sprite = ExtResource("7_rv2iy")
metadata/_custom_type_script = "uid://86nuwqny3eip"

[sub_resource type="Resource" id="Resource_u1q06"]
script = ExtResource("1_iaqwv")
Text = "You can count on me!!"
Sprite = ExtResource("8_85af3")
metadata/_custom_type_script = "uid://86nuwqny3eip"

