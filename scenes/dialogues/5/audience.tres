[sub_resource type="Resource" id="Resource_bj31u"]
script = ExtResource("1_twdt8")
Text = "I have been sent here to deliver
a request from the Elf Queen"
Sprite = ExtResource("5_vh01k")
metadata/_custom_type_script = "uid://86nuwqny3eip"

[sub_resource type="Resource" id="Resource_y6c67"]
script = ExtResource("1_twdt8")
Text = "The Elf King is bedridden.
The situation is dire.
We need your healing potion."
Sprite = ExtResource("6_hq2xv")
metadata/_custom_type_script = "uid://86nuwqny3eip"

[sub_resource type="Resource" id="Resource_6tuxq"]
script = ExtResource("1_twdt8")
