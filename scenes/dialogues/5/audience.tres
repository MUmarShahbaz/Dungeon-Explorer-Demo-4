Right_Side = true
metadata/_custom_type_script = "uid://86nuwqny3eip"

[sub_resource type="Resource" id="Resource_xyith"]
script = ExtResource("1_twdt8")
Text = "The Elf Queen is an 
old friend of mine."
Sprite = ExtResource("7_xokue")
Right_Side = true
metadata/_custom_type_script = "uid://86nuwqny3eip"

[sub_resource type="Resource" id="Resource_fy80o"]
