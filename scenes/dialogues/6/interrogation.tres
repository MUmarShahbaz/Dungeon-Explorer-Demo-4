[sub_resource type="Resource" id="Resource_lnwos"]
script = ExtResource("1_uth3l")
Text = "The mercenary explains:
Someone from the nobility is corrupt
and is planning a coup."
metadata/_custom_type_script = "uid://86nuwqny3eip"

[sub_resource type="Resource" id="Resource_etcte"]
script = ExtResource("1_uth3l")
Text = "The King's sickness is thanks to
a special poison from overseas"
metadata/_custom_type_script = "uid://86nuwqny3eip"

[sub_resource type="Resource" id="Resource_fxopj"]
script = ExtResource("1_uth3l")
Text = "The mercenaries were only asked
to stop you from reaching the castle"
metadata/_custom_type_script = "uid://86nuwqny3eip"

[sub_resource type="Resource" id="Resource_2pbkb"]
script = ExtResource("1_uth3l")
Text = "They were contacted via letter
The don't know who hired them"
metadata/_custom_type_script = "uid://86nuwqny3eip"

[sub_resource type="Resource" id="Resource_ykmg5"]
script = ExtResource("1_uth3l")
Text = "I must make haste and go
straight to the castle"
