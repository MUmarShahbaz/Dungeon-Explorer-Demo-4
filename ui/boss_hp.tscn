[sub_resource type="GDScript" id="GDScript_cnwu3"]
script/source = "extends Control

@export var boss : Entity

func _ready() -> void:
	$HP.max_value = boss.HitPoints

func _physics_process(_delta: float) -> void:
	if not boss: queue_free()
	else: $HP.value = boss.hp
"

