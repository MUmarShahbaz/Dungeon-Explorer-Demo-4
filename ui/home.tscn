[sub_resource type="GDScript" id="GDScript_tt30a"]
script/source = "extends CanvasLayer

func _ready() -> void:
	await QuickScripts.fade_in()
	AudioServer.set_bus_volume_linear(QuickScripts.audio_music_bus, 1)
	$Menu/Main/Play.grab_focus()

func _physics_process(_delta: float) -> void:
	if Input.is_action_just_pressed(\"interact\") or Input.is_action_just_pressed(\"ui_cancel\"): _on_back_pressed()

@onready var Main := $Menu/Main
@onready var Audio := $Menu/Audio
@onready var Controls := $Menu/Controls
@onready var Missions := $Menu/Missions
@onready var Stats := $\"Menu/Entity Stats\"
@onready var Back := $Menu/Back

enum states {Main, Audio, Controls, Missions, Stats}

func change_state(new_state : states):
	if new_state == states.Main:
		Main.show()
		$Menu/Main/Play.grab_focus()
		Audio.hide()
		Controls.hide()
		Missions.hide()
		Stats.hide()
		Back.hide()
	else:
		Main.hide()
		Back.show()
		Back.grab_focus()
		match new_state:
			states.Audio: Audio.show()
			states.Controls: Controls.show()
			states.Missions: Missions.show()
			states.Stats: Stats.show()

func _on_back_pressed() -> void:
	change_state(states.Main)

func _on_audio_pressed() -> void:
	change_state(states.Audio)

func _on_controls_pressed() -> void:
	change_state(states.Controls)

func _on_missions_pressed() -> void:
	change_state(states.Missions)

func _on_entity_stats_pressed() -> void:
	change_state(states.Stats)

var play_pressed := false
func _on_play_pressed() -> void:
	if play_pressed: return
	play_pressed = true
	var start_lvl = QuickScripts.get_lvl(1)
	await QuickScripts.fade_out()
	get_tree().change_scene_to_packed(start_lvl)
"

