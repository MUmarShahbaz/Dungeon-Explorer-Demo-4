[sub_resource type="GDScript" id="GDScript_3283v"]
script/source = "extends Level

func _ready() -> void:
	super._ready()
	QuickScripts.player_spawned.connect(_on_player_spawned)
	$Dungeon/Doors/door0.door_opened.connect(func (_x): QuickScripts.open_lvl(8))
	#$Dungeon/Doors/door16.lock()
	#$Dungeon/Doors/door0.lock()

func prepare_map():
	$Dungeon/Torches.ghost_flame()
	$Dungeon/Vignette.show()
	$\"Dungeon/Tilemap layers/Entry platforms\".queue_free()
	for door in $Dungeon/Doors.get_children():
		door.door_opened.connect(func (_x): if door.exit != null: player_spawn_position = door.exit.global_position)
		door.unlock()

var death_count : int = -1
func _on_player_spawned(player: Player) -> void:
	player.entity_died.connect(QuickScripts.spawn)
	death_count += 1
	if death_count == 0: QuickScripts.new_dialogue(null, \"res://scenes/dialogues/temp/6.tres\")
	$Dungeon/Vignette.add_mini_map_vignette(QuickScripts.hud)
"

[sub_resource type="GDScript" id="GDScript_y5plx"]
script/source = "extends Spawner

func _ready(): pass
func _on_body_entered(_body: Node2D) -> void:
	begin()
"

